# ============================================================================
# CineQ - Spring Boot Movie Booking System
# Environment Variables Configuration (.env.example)
# ============================================================================
# Copy this file to .env and update values for your environment
# This file is for reference - do NOT commit actual secrets to git
# ============================================================================

# ============================================================================
# 1. APPLICATION PROFILES & LOGGING
# ============================================================================

# Spring Boot Profile: local, docker, mongodb-atlas
# local     = Local development with PostgreSQL + MongoDB
# docker    = Production Docker/Kubernetes deployment
# mongodb-atlas = Cloud deployment with MongoDB Atlas
SPRING_PROFILES_ACTIVE=docker

# Logging Level: ERROR, WARN, INFO, DEBUG, TRACE
# ERROR   = Only errors (production - minimal logging)
# WARN    = Warnings + errors (troubleshooting)
# INFO    = General info + warnings + errors
# DEBUG   = All details including SQL queries (development)
# TRACE   = Everything including parameter binding (rare)
APP_LOG_LEVEL=ERROR

# Server Port (default 8080)
PORT=8080

# ============================================================================
# 2. MONGODB CONFIGURATION
# ============================================================================

# Local Development: mongodb://localhost:27017/cineqdb
# MongoDB Atlas:    mongodb+srv://username:password@cluster.mongodb.net/cineqdb
# Railway:          mongodb://username:password@host:port/cineqdb
# Render:           mongodb://username:password@host:port/cineqdb

# IMPORTANT: Always include connection pool parameters!
# Format: mongodb://host:port/database?maxPoolSize=5&minPoolSize=1&maxIdleTimeMS=30000

MONGODB_URI=mongodb://localhost:27017/cineqdb?maxPoolSize=5&minPoolSize=1&maxIdleTimeMS=30000&waitQueueTimeoutMS=10000

# Auto-create MongoDB indexes on startup
# Set to 'false' in production for faster startup
MONGODB_AUTO_INDEX_CREATION=true

# ============================================================================
# 3. POSTGRESQL CONFIGURATION (For Legacy Modules)
# ============================================================================

# Local Development: localhost
# Cloud (Aiven/Railway): provided by cloud provider
# Format: jdbc:postgresql://host:port/database

DB_URL=jdbc:postgresql://localhost:5432/cineqdb
DB_USERNAME=postgres
DB_PASSWORD=postgres_password_here
DB_DRIVER=org.postgresql.Driver

# ============================================================================
# 4. JWT & SECURITY
# ============================================================================

# JWT Secret Key (minimum 32 characters for security)
# Generate: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long_here

# JWT Expiration time in milliseconds
# 900000   = 15 minutes
# 3600000  = 1 hour
# 86400000 = 24 hours
JWT_EXPIRATION=86400000

# Prominent Role (bypasses all permission checks)
# Typically SUPER_ADMIN for administrators
PROMINENT_ROLE=SUPER_ADMIN

# Authorization Provider: RBAC or WORKFLOW
AUTH_PROVIDER=RBAC

# ============================================================================
# 5. CORS CONFIGURATION
# ============================================================================

# Allowed origins for CORS (comma-separated)
# Development:  http://localhost:3000,http://localhost:4200
# Production:   https://cineq.tech,https://www.cineq.tech
# NEVER use * in production - always specify exact origins

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# ============================================================================
# 5.1 COOKIE CONFIGURATION (HttpOnly Authentication - Security Update)
# ============================================================================

# Enable Secure flag for cookies (HTTPS only)
# Development (HTTP):  false
# Production (HTTPS):  true
# IMPORTANT: Must be true in production with HTTPS
COOKIE_SECURE=true

# ============================================================================
# 5.2 RATE LIMITING (Anti-Brute-Force Protection - Security Update)
# ============================================================================

# Enable/disable rate limiting on authentication endpoints
# Development: true (recommended to test)
# Production:  true (MUST be enabled)
RATE_LIMIT_ENABLED=true

# ============================================================================
# 6. EMAIL CONFIGURATION
# ============================================================================

# SMTP Server Configuration
# Gmail:    smtp.gmail.com
# SendGrid: smtp.sendgrid.net
# Outlook:  smtp-mail.outlook.com

APP_EMAIL_SMTP_HOST=smtp.gmail.com
APP_EMAIL_SMTP_PORT=587
APP_EMAIL_SMTP_USERNAME=your_email@gmail.com
APP_EMAIL_SMTP_PASSWORD=your_app_password_here

# Email Sender Information
APP_EMAIL_FROM_ADDRESS=noreply@cineq.com
APP_EMAIL_FROM_NAME=CineQ

# TLS/SSL Configuration
APP_EMAIL_ENABLE_TLS=true
APP_EMAIL_ENABLE_SSL=false

# Admin Notification Emails (comma-separated for multiple)
ADMIN_NOTIFICATION_EMAILS=admin@cineq.com,manager@cineq.com

# ============================================================================
# 7. APPLICATION URLS
# ============================================================================

# Backend API URL (for email links, etc.)
# Local:      http://localhost:8080
# Production: https://api.cineq.com
APP_API_URL=http://localhost:8080

# Frontend Customer URL (for email verification links)
# Local:      http://localhost:3000
# Production: https://cineq.com
APP_FRONTEND_URL=http://localhost:3000

# Admin Dashboard URL
APP_ADMIN_URL=http://localhost:3000

# ============================================================================
# 8. CUSTOMER AUTHENTICATION SETTINGS
# ============================================================================

# Require email verification before customer login
CUSTOMER_EMAIL_VERIFICATION=false

# Failed login attempt limits (anti-brute-force)
CUSTOMER_MAX_FAILED_ATTEMPTS=10

# Account lockout duration (in minutes)
CUSTOMER_LOCKOUT_MINUTES=60

# Password reset token expiry (in hours)
CUSTOMER_RESET_TOKEN_EXPIRY=24

# ============================================================================
# 9. FILE STORAGE CONFIGURATION
# ============================================================================

# Storage type: local, s3, supabase
FILE_STORAGE_TYPE=local

# Maximum file size (in bytes)
FILE_STORAGE_MAX_SIZE=2097152

# Spring multipart file upload limits
SPRING_MULTIPART_MAX_FILE_SIZE=3MB
SPRING_MULTIPART_MAX_REQUEST_SIZE=20MB

# ============================================================================
# 10. SUPABASE CONFIGURATION (Optional)
# ============================================================================

SUPABASE_API_KEY=your_supabase_api_key_here
SUPABASE_API_URL=https://your-project.supabase.co

# ============================================================================
# 11. REDIS CONFIGURATION (For Docker/Production)
# ============================================================================

# Redis Host and Port
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# QUICK START - COPY & PASTE EXAMPLES
# ============================================================================

# LOCAL DEVELOPMENT
# SPRING_PROFILES_ACTIVE=local
# APP_LOG_LEVEL=DEBUG
# MONGODB_URI=mongodb://localhost:27017/cineqdb?maxPoolSize=5&minPoolSize=1&maxIdleTimeMS=30000
# JWT_SECRET=dev_secret_key_32_characters_minimum
# JWT_EXPIRATION=86400000
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# DOCKER LOCAL
# SPRING_PROFILES_ACTIVE=docker
# APP_LOG_LEVEL=DEBUG
# MONGODB_URI=mongodb://mongo:27017/cineqdb?maxPoolSize=10&minPoolSize=2&maxIdleTimeMS=30000
# JWT_SECRET=dev_secret_key_32_characters_minimum
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# PRODUCTION - MongoDB Atlas
# SPRING_PROFILES_ACTIVE=docker
# APP_LOG_LEVEL=ERROR
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/cineqdb?maxPoolSize=5&minPoolSize=1&maxIdleTimeMS=30000&waitQueueTimeoutMS=10000
# JWT_SECRET=production_secret_key_very_secure_32_plus_chars
# JWT_EXPIRATION=3600000
# CORS_ALLOWED_ORIGINS=https://cineq.com,https://www.cineq.com
# APP_EMAIL_SMTP_HOST=smtp.sendgrid.net
# CUSTOMER_EMAIL_VERIFICATION=true

