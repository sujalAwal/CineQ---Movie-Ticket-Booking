            "@Size(min=1, max=2, message='Code must be 1-2 characters')",
            "@Pattern(regexp='^[A-Z0-9]+$', message='Code must contain only uppercase letters and numbers')"
          ],
          "actionRules": {
            "create": [
              "@NotBlank(message='Code is required')",
              "@Size(min=1, max=2)",
              "@Pattern(regexp='^[A-Z0-9]+$')",
              "@Unique(collection='showtime_statuses', field='code', message='Code already exists')"
            ],
            "update": [
              "@Size(min=1, max=2)",
              "@Pattern(regexp='^[A-Z0-9]+$')",
              "@UniqueExcludingSelf(collection='showtime_statuses', field='code', idField='_id', message='Code already exists')"
            ],
            "delete": []
          },
          "serialization": {
            "select": true,
            "outputField": "code"
          }
        },

        "name": {
          "type": "STRING",
          "collectionField": "name",
          "fieldTransformer": "trim",
          "baseValidation": [
            "@NotBlank(message='Name is required')",
            "@Size(min=2, max=50, message='Name must be 2-50 characters')"
          ],
          "actionRules": {
            "create": [
              "@NotBlank(message='Name is required')",
              "@Size(min=2, max=50)",
              "@Unique(collection='showtime_statuses', field='name', message='Name already exists')"
            ],
            "update": [
              "@Size(min=2, max=50)",
              "@UniqueExcludingSelf(collection='showtime_statuses', field='name', idField='_id', message='Name already exists')"
            ],
            "delete": []
          },
          "serialization": {
            "select": true,
            "outputField": "name"
          }
        },

        "description": {
          "type": "STRING",
          "collectionField": "description",
          "fieldTransformer": "trim",
          "baseValidation": [
            "@Size(min=0, max=500, message='Description cannot exceed 500 characters')"
          ],
          "actionRules": {
            "create": [
              "@Size(min=0, max=500)"
            ],
            "update": [
              "@Size(min=0, max=500)"
            ],
            "delete": []
