            "interceptors": {
              "before": [
                {
                  "handler": "logAction",
                  "args": {
                    "message": "Creating new showtime",
                    "level": "INFO",
                    "includeFormData": true
                  },
                  "when": null
                },
                {
                  "handler": "preventShowtimeOverlap",
                  "args": {
                    "movieCollection": "movies",
                    "screenCollection": "screens",
                    "showtimeCollection": "showtimes",
                    "movieDurationField": "duration",
                    "screenBreakTimeField": "breakTime"
                  },
                  "when": null
                }
              ],
              "afterReturning": [
                {
                  "handler": "invalidateCache",
                  "args": {
                    "cacheNames": ["showtimes"]
                  },
                  "when": null
                },
                {
                  "handler": "auditLog",
                  "args": {
                    "action": "CREATE",
                    "entity": "Showtime",
                    "includeData": true
                  },
                  "when": null
                }
              ],
              "afterThrowing": [
                {
                  "handler": "logAction",
                  "args": {
                    "message": "Showtime creation failed",
                    "level": "ERROR"
                  },
                  "when": null
                }
              ]
            },
            "messages": {
              "success": "Showtime created successfully",
              "error": "Failed to create showtime",
              "validation": "Please check the form for errors"
            }
          },

          "update": {
            "enabled": true,
            "autoApprove": true,
            "autoFields": {
              "updatedAt": "{{now}}",
              "updatedBy": "{{currentUser}}"
            },
            "interceptors": {
              "before": [
                {
                  "handler": "logAction",
                  "args": {
                    "message": "Updating showtime",
                    "level": "INFO"
                  },
                  "when": null
                },
                {
                  "handler": "preventShowtimeOverlap",
                  "args": {
                    "movieCollection": "movies",
                    "screenCollection": "screens",
                    "showtimeCollection": "showtimes",
                    "movieDurationField": "duration",
                    "screenBreakTimeField": "breakTime",
                    "excludeCurrentRecord": true
                  },
                  "when": null
                }
              ],
              "afterReturning": [
                {
                  "handler": "invalidateCache",
                  "args": {
                    "cacheNames": ["showtimes"]
                  },
                  "when": null
                },
                {
                  "handler": "auditLog",
                  "args": {
                    "action": "UPDATE",
                    "entity": "Showtime",
                    "includeData": true
                  },
                  "when": null
                }
              ],
              "afterThrowing": [
                {
                  "handler": "logAction",
                  "args": {
                    "message": "Showtime update failed",
                    "level": "ERROR"
                  },
                  "when": null
                }
              ]
            },
            "messages": {
              "success": "Showtime updated successfully",
              "error": "Failed to update showtime",
              "notFound": "Showtime not found or has been deleted"
            }
          },

          "delete": {
            "enabled": true,
            "autoApprove": true,
            "softDelete": true,
            "autoFields": {
              "deletedAt": "{{now}}",
              "deletedBy": "{{currentUser}}"
            },
            "interceptors": {
              "before": [
                {
                  "handler": "logAction",
                  "args": {
                    "message": "Deleting showtime",
                    "level": "INFO"
                  },
                  "when": null
                }
              ],
              "afterReturning": [
                {
                  "handler": "invalidateCache",
                  "args": {
                    "cacheNames": ["showtimes"]
                  },
                  "when": null
                },
                {
                  "handler": "auditLog",
                  "args": {
                    "action": "DELETE",
                    "entity": "Showtime"
                  },
                  "when": null
                }
              ]
            },
            "messages": {
              "success": "Showtime deleted successfully",
              "error": "Failed to delete showtime",
              "notFound": "Showtime not found"
            }
          }
        },

