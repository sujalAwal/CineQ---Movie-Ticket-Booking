{
  "slug": "showtimes",
  "title": "Showtime Management",
  "description": "Manage movie showtimes with overlap prevention (considers movie duration and screen break time)",
  "modelName": "Showtime",
  "isActive": true,

  "formSteps": [
    {
      "stepSlug": "v1",
      "stepTitle": "Showtime Configuration",
      "stepOrder": 1,
      "isActive": true,
      "description": "Create, update, or delete showtimes with automatic overlap prevention",

      "formSchema": {
        "type": "object",
        "title": "Showtime Form",
        "properties": {
          "movieId": {
            "type": "STRING",
            "title": "Movie",
            "placeholder": "Select movie",
            "description": "Movie to be shown",
            "required": true,
            "order": 1
          },
          "screenId": {
            "type": "STRING",
            "title": "Screen",
            "placeholder": "Select screen",
            "description": "Screen where the movie will be shown",
            "required": true,
            "order": 2
          },
          "theatreId": {
            "type": "STRING",
            "title": "Theatre",
            "placeholder": "Select theatre",
            "description": "Theatre containing the screen",
            "required": true,
            "order": 3
          },
          "showDate": {
            "type": "DATE",
            "title": "Show Date",
            "placeholder": "YYYY-MM-DD",
            "description": "Date of the showtime",
            "required": true,
            "order": 6
          },
          "showTime": {
            "type": "STRING",
            "title": "Show Time",
            "placeholder": "HH:MM (24-hour format)",
            "description": "Time when the show starts",
            "required": true,
            "order": 7
          },
          "language": {
            "type": "STRING",
            "title": "Language",
            "placeholder": "e.g., ENG, HIN, NEP, MAL, MARA",
            "description": "Language of the movie for this showtime",
            "required": true,
            "order": 8
          },
          "format": {
            "type": "STRING",
            "title": "Format",
            "placeholder": "e.g., 2D, 3D, IMAX, 4DX",
            "description": "Screen format for this showtime",
            "required": true,
            "order": 9
          },
          "statusCode": {
            "type": "STRING",
            "title": "Status",
            "placeholder": "Select status",
            "description": "Showtime status (AV=Available, HF=Housefull, X=Cancelled)",
            "required": true,
            "order": 10
          },
          "pricePerLayout": {
            "type": "ARRAY",
            "title": "Price Per Seat Type",
            "placeholder": "e.g., [{code: 'P', basePrice: 500}]",
            "description": "Price mapping for each seat type code",
            "required": true,
            "order": 11
          },
          "seatLayout": {
            "type": "ARRAY",
            "title": "Seat Layout",
            "placeholder": "e.g., [{seatName: 'A1', row: 'A', col: 1, code: 'P', price: 500}]",
            "description": "Individual seat configuration with pricing",
            "required": true,
            "order": 12
          },
          "isActive": {
            "type": "BOOLEAN",
            "title": "Active",
            "description": "Whether this showtime is operational",
            "default": true,
            "order": 13
          }
        },
        "required": ["movieId", "screenId", "theatreId", "showDate", "showTime", "language", "format", "statusCode", "pricePerLayout", "seatLayout"]
      },

      "validationRules": {
        "movieId": {
          "type": "STRING",
          "collectionField": "movieId",
          "fieldTransformer": null,
          "baseValidation": [
            "@NotBlank(message='Movie is required')",
            "@Exists(collection='movies', field='_id', message='Movie not found')"
          ],
          "actionRules": {
            "create": [
              "@NotBlank(message='Movie is required')",
              "@Exists(collection='movies', field='_id', message='Movie not found')"
            ],
            "update": [
              "@Exists(collection='movies', field='_id', message='Movie not found')"
            ],
            "delete": []
          },
          "serialization": {
            "select": true,
            "outputField": "movieId"
          }
        },

        "screenId": {
          "type": "STRING",
          "collectionField": "screenId",
          "fieldTransformer": null,
          "baseValidation": [
            "@NotBlank(message='Screen is required')",
            "@Exists(collection='screens', field='_id', message='Screen not found')"
          ],
          "actionRules": {
            "create": [
              "@NotBlank(message='Screen is required')",
              "@Exists(collection='screens', field='_id', message='Screen not found')"
            ],
            "update": [
              "@Exists(collection='screens', field='_id', message='Screen not found')"
            ],
            "delete": []
          },
          "serialization": {
            "select": true,
            "outputField": "screenId"
          }
        },

        "theatreId": {
          "type": "STRING",
          "collectionField": "theatreId",
          "fieldTransformer": null,
          "baseValidation": [
            "@NotBlank(message='Theatre is required')",
            "@Exists(collection='theatres', field='_id', message='Theatre not found')"
          ],
          "actionRules": {
            "create": [
              "@NotBlank(message='Theatre is required')",
              "@Exists(collection='theatres', field='_id', message='Theatre not found')"
            ],
            "update": [
              "@Exists(collection='theatres', field='_id', message='Theatre not found')"
            ],
            "delete": []
          },
          "serialization": {
            "select": true,
            "outputField": "theatreId"
          }
        },

        "showDate": {
          "type": "DATE",
          "collectionField": "showDate",
          "fieldTransformer": null,
          "baseValidation": [
            "@NotNull(message='Show date is required')",
            "@FutureDate(message='Show date must be in the future')"
          ],
          "actionRules": {
            "create": [
              "@NotNull(message='Show date is required')",
              "@FutureDate(message='Show date must be in the future')"
            ],
            "update": [
              "@FutureDate(message='Show date must be in the future')"
            ],
            "delete": []
          },
          "serialization": {
            "select": true,
            "outputField": "showDate"
          }
        },

        "showTime": {
          "type": "STRING",
          "collectionField": "showTime",
          "fieldTransformer": "trim",
          "baseValidation": [
            "@NotBlank(message='Show time is required')",
            "@Pattern(regexp='^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$', message='Show time must be in HH:MM format (24-hour)')"
          ],
          "actionRules": {
            "create": [
              "@NotBlank(message='Show time is required')",
              "@Pattern(regexp='^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$')"
            ],
            "update": [
              "@Pattern(regexp='^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$')"
            ],
            "delete": []
          },
          "serialization": {
            "select": true,
            "outputField": "showTime"
          }
        },

        "language": {
          "type": "STRING",
          "collectionField": "language",
          "fieldTransformer": "uppercase",
          "baseValidation": [
            "@NotBlank(message='Language is required')",
            "@Pattern(regexp='^[A-Z]{2,4}$', message='Language must be 2-4 uppercase letters')"
          ],
          "actionRules": {
            "create": [
              "@NotBlank(message='Language is required')",
              "@Pattern(regexp='^[A-Z]{2,4}$')"
            ],
            "update": [
              "@Pattern(regexp='^[A-Z]{2,4}$')"
            ],
            "delete": []
          },
          "serialization": {
            "select": true,
            "outputField": "language"
          }
        },

        "format": {
          "type": "STRING",
          "collectionField": "format",
          "fieldTransformer": "uppercase",
          "baseValidation": [
            "@NotBlank(message='Format is required')",
            "@Pattern(regexp='^(2D|3D|IMAX|4DX)$', message='Format must be one of: 2D, 3D, IMAX, 4DX')"
          ],
          "actionRules": {
            "create": [
              "@NotBlank(message='Format is required')",
              "@Pattern(regexp='^(2D|3D|IMAX|4DX)$')"
            ],
            "update": [
              "@Pattern(regexp='^(2D|3D|IMAX|4DX)$')"
            ],
            "delete": []
          },
          "serialization": {
            "select": true,
            "outputField": "format"
          }
        },

        "statusCode": {
          "type": "STRING",
          "collectionField": "statusCode",
          "fieldTransformer": "uppercase",
          "baseValidation": [
            "@NotBlank(message='Status is required')",
            "@Exists(collection='showtime_statuses', field='code', message='Invalid showtime status')"
          ],
          "actionRules": {
            "create": [
              "@NotBlank(message='Status is required')",
              "@Exists(collection='showtime_statuses', field='code', message='Invalid showtime status')"
            ],
            "update": [
              "@Exists(collection='showtime_statuses', field='code', message='Invalid showtime status')"
            ],
            "delete": []
          },
          "serialization": {
            "select": true,
            "outputField": "statusCode"
          }
        },

        "pricePerLayout": {
          "type": "ARRAY",
          "collectionField": "pricePerLayout",
          "baseValidation": [
            "@NotEmpty(message='At least one seat type price is required')",
            "@Size(min=1, max=10, message='Maximum 10 seat types allowed')"
          ],
          "nestedValidations": [
            {
              "fieldName": "pricePerLayout[*].code",
              "type": "STRING",
              "required": true,
              "baseValidation": [
                "@NotBlank(message='Seat type code cannot be blank')",
                "@EachExists(collection='seat_types', field='code', message='Seat type code does not exist')"
              ]
            },
            {
              "fieldName": "pricePerLayout[*].basePrice",
              "type": "DOUBLE",
              "required": true,
              "baseValidation": [
                "@NotNull(message='Price is required for each seat type')",
                "@Min(value=50, message='Price must be minimum 50')",
                "@Max(value=1500, message='Price cannot exceed 1500')"
              ]
            }
          ],
          "serialization": {
            "select": true,
            "outputField": "pricePerLayout"
          }
        },

        "seatLayout": {
          "type": "ARRAY",
          "collectionField": "seatLayout",
          "baseValidation": [
            "@NotEmpty(message='At least one seat must be defined')",
            "@Size(min=1, max=500, message='Maximum 500 seats allowed per showtime')"
          ],
          "nestedValidations": [
            {
              "fieldName": "seatLayout[*].seatName",
              "type": "STRING",
              "required": true,
              "baseValidation": [
                "@NotBlank(message='Seat name cannot be blank')",
                "@Size(min=2, max=4, message='Seat name must be 2-4 characters')"
              ]
            },
            {
              "fieldName": "seatLayout[*].row",
              "type": "STRING",
              "required": true,
              "baseValidation": [
                "@NotBlank(message='Row cannot be blank')",
                "@Pattern(regexp='^[A-Z]+$', message='Row must contain only uppercase letters A-Z')"
              ]
            },
            {
              "fieldName": "seatLayout[*].col",
              "type": "INTEGER",
              "required": true,
              "baseValidation": [
                "@Min(value=1, message='Column must be at least 1')",
                "@Max(value=100, message='Column cannot exceed 100')"
              ]
            },
            {
              "fieldName": "seatLayout[*].code",
              "type": "STRING",
              "required": true,
              "baseValidation": [
                "@NotBlank(message='Seat type code cannot be blank')",
                "@EachExists(collection='seat_types', field='code', message='Seat type code does not exist')"
              ]
            },
            {
              "fieldName": "seatLayout[*].price",
              "type": "DOUBLE",
              "required": true,
              "baseValidation": [
                "@NotNull(message='Price is required for each seat')",
                "@Min(value=50, message='Price must be minimum 50')",
                "@Max(value=1500, message='Price cannot exceed 1500')"
              ]
            }
          ],
          "serialization": {
            "select": true,
            "outputField": "seatLayout"
          }
        },

        "isActive": {
          "type": "BOOLEAN",
          "collectionField": "isActive",
          "fieldTransformer": null,
          "baseValidation": [],
          "actionRules": {
            "create": [],
            "update": [],
            "delete": []
          },
          "serialization": {
            "select": true,
            "outputField": "isActive"
          }
        },

        "id": {
          "type": "STRING",
          "collectionField": "_id",
          "fieldTransformer": null,
          "baseValidation": [],
          "actionRules": {
            "create": [],
            "update": [
              "@NotBlank(message='ID is required for update')",
              "@Exists(collection='showtimes', field='_id', message='Showtime not found')"
            ],
            "delete": [
              "@NotBlank(message='ID is required for delete')",
              "@Exists(collection='showtimes', field='_id', message='Showtime not found')"
            ]
          },
          "serialization": {
            "select": true,
            "outputField": "id"
          }
        }
      },

      "workflowRules": {
        "persistToCollection": true,
        "targetCollection": "showtimes",
        "fieldMapping": {
          "movieId": "movieId",
          "screenId": "screenId",
          "theatreId": "theatreId",
          "showDate": "showDate",
          "showTime": "showTime",
          "language": "language",
          "format": "format",
          "statusCode": "statusCode",
          "pricePerLayout": "pricePerLayout",
          "seatLayout": "seatLayout",
          "isActive": "isActive"
        },
        "autoFields": {
          "createdAt": "{{now}}",
          "updatedAt": "{{now}}",
          "deletedAt": null,
          "createdBy": "{{currentUser}}",
          "updatedBy": "{{currentUser}}"
        },
        "actions": {
          "create": {
            "enabled": true,
            "autoApprove": true,
            "autoFields": {
              "createdAt": "{{now}}",
              "updatedAt": "{{now}}",
              "deletedAt": null,
              "createdBy": "{{currentUser}}",
              "updatedBy": "{{currentUser}}"
            },
            "interceptors": {
              "before": [
                {
                  "handler": "logAction",
                  "args": {
                    "message": "Creating new showtime",
                    "level": "INFO",
                    "includeFormData": true
                  },
                  "when": null
                },
                {
                  "handler": "preventShowtimeOverlap",
                  "args": {
                    "movieCollection": "movies",
                    "screenCollection": "screens",
                    "showtimeCollection": "showtimes",
                    "movieDurationField": "duration",
                    "screenBreakTimeField": "breakTime"
                  },
                  "when": null
                }
              ],
              "afterReturning": [
                {
                  "handler": "invalidateCache",
                  "args": {
                    "cacheNames": ["showtimes"]
                  },
                  "when": null
                },
                {
                  "handler": "auditLog",
                  "args": {
                    "action": "CREATE",
                    "entity": "Showtime",
                    "includeData": true
                  },
                  "when": null
                }
              ],
              "afterThrowing": [
                {
                  "handler": "logAction",
                  "args": {
                    "message": "Showtime creation failed",
                    "level": "ERROR"
                  },
                  "when": null
                }
              ]
            },
            "messages": {
              "success": "Showtime created successfully",
              "error": "Failed to create showtime",
              "validation": "Please check the form for errors"
            }
          },

          "update": {
            "enabled": true,
            "autoApprove": true,
            "autoFields": {
              "updatedAt": "{{now}}",
              "updatedBy": "{{currentUser}}"
            },
            "interceptors": {
              "before": [
                {
                  "handler": "logAction",
                  "args": {
                    "message": "Updating showtime",
                    "level": "INFO"
                  },
                  "when": null
                },
                {
                  "handler": "preventShowtimeOverlap",
                  "args": {
                    "movieCollection": "movies",
                    "screenCollection": "screens",
                    "showtimeCollection": "showtimes",
                    "movieDurationField": "duration",
                    "screenBreakTimeField": "breakTime",
                    "excludeCurrentRecord": true
                  },
                  "when": null
                }
              ],
              "afterReturning": [
                {
                  "handler": "invalidateCache",
                  "args": {
                    "cacheNames": ["showtimes"]
                  },
                  "when": null
                },
                {
                  "handler": "auditLog",
                  "args": {
                    "action": "UPDATE",
                    "entity": "Showtime",
                    "includeData": true
                  },
                  "when": null
                }
              ],
              "afterThrowing": [
                {
                  "handler": "logAction",
                  "args": {
                    "message": "Showtime update failed",
                    "level": "ERROR"
                  },
                  "when": null
                }
              ]
            },
            "messages": {
              "success": "Showtime updated successfully",
              "error": "Failed to update showtime",
              "notFound": "Showtime not found or has been deleted"
            }
          },

          "delete": {
            "enabled": true,
            "autoApprove": true,
            "softDelete": true,
            "autoFields": {
              "deletedAt": "{{now}}",
              "deletedBy": "{{currentUser}}"
            },
            "interceptors": {
              "before": [
                {
                  "handler": "logAction",
                  "args": {
                    "message": "Deleting showtime",
                    "level": "INFO"
                  },
                  "when": null
                }
              ],
              "afterReturning": [
                {
                  "handler": "invalidateCache",
                  "args": {
                    "cacheNames": ["showtimes"]
                  },
                  "when": null
                },
                {
                  "handler": "auditLog",
                  "args": {
                    "action": "DELETE",
                    "entity": "Showtime"
                  },
                  "when": null
                }
              ]
            },
            "messages": {
              "success": "Showtime deleted successfully",
              "error": "Failed to delete showtime",
              "notFound": "Showtime not found"
            }
          }
        },

        "permissions": {
          "view": ["ADMIN", "SUPERADMIN", "USER"],
          "create": ["ADMIN", "SUPERADMIN"],
          "update": ["ADMIN", "SUPERADMIN"],
          "delete": ["SUPERADMIN"]
        }
      },

      "uiSchema": {
        "layout": "two-column",
        "sections": [
          {
            "title": "Basic Information",
            "fields": ["movieId", "screenId", "theatreId"]
          },
          {
            "title": "Schedule",
            "fields": ["showDate", "showTime"]
          },
          {
            "title": "Configuration",
            "fields": ["language", "format", "statusCode", "pricePerLayout", "seatLayout"]
          },
          {
            "title": "Status",
            "fields": ["isActive"]
          }
        ],
        "submitButton": {
          "label": "Save Showtime",
          "loadingLabel": "Saving..."
        }
      },

      "metadata": {
        "category": "cinema-management",
        "version": "1.0",
        "lastUpdated": "2026-02-12T00:00:00Z",
        "fieldCount": 11,
        "author": "system",
        "notes": "Includes automatic overlap prevention via preventShowtimeOverlap interceptor. Price per seat type and individual seat pricing with validation."
      }
    }
  ],

