      "formSchema": {
        "type": "object",
        "title": "Artist Form",
        "properties": {
          "fullName": {
            "type": "STRING",
            "title": "Artist Name",
            "placeholder": "Enter artist full name",
            "description": "Full name of the artist (must be unique)",
            "required": true,
            "order": 1
          },
          "email": {
            "type": "STRING",
            "title": "Email",
            "placeholder": "Enter email address",
            "description": "Contact email for the artist",
            "required": false,
            "order": 2,
            "ui": {
              "widget": "email"
            }
          },
          "avatar": {
            "type": "STRING",
            "title": "Avatar URL",
            "placeholder": "e.g., /uploads/artist.jpg",
            "description": "Profile image URL or file path",
            "required": false,
            "order": 3
          },
          "artistTypeId": {
            "type": "STRING",
            "title": "Artist Type",
            "placeholder": "Select artist type",
            "description": "Category this artist belongs to (e.g., Actor, Director)",
            "required": false,
            "order": 4,
            "ui": {
              "widget": "select",
              "dataSource": {
                "collection": "artist_types",
                "labelField": "name",
                "valueField": "_id",
                "filter": { "isActive": true, "deletedAt": null }
              }
            }
          },
          "birthDate": {
            "type": "DATE",
            "title": "Birth Date",
            "placeholder": "",
            "description": "Date of birth of the artist",
            "required": false,
            "order": 5
          },
          "nationality": {
            "type": "STRING",
            "title": "Nationality",
            "placeholder": "e.g., American, British, Indian",
            "description": "Country of origin or citizenship",
            "required": false,
            "order": 6
          },
          "bio": {
            "type": "STRING",
            "title": "Biography",
            "placeholder": "Enter artist biography...",
            "description": "Brief biography of the artist",
            "required": false,
            "order": 7,
            "ui": {
              "widget": "textarea",
              "rows": 3
            }
          },
          "moviesCount": {
            "type": "INTEGER",
            "title": "Movies Count",
            "placeholder": "0",
            "description": "Number of movies this artist has appeared in (nullable)",
            "required": false,
            "order": 8
          },
          "rating": {
            "type": "DECIMAL",
            "title": "Rating",
            "placeholder": "e.g., 8.5",
            "description": "Overall rating from 0.0 to 10.0 (nullable)",
            "required": false,
            "order": 9
          },
          "isActive": {
            "type": "BOOLEAN",
            "title": "Active",
            "description": "Whether this artist is active and visible on the platform",
            "default": true,
            "order": 10
          }
        },
        "required": ["fullName"]
      },

