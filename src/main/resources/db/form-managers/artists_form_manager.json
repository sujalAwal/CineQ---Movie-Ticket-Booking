          },

          "delete": {
            "enabled": true,
            "autoApprove": true,
            "softDelete": true,
            "autoFields": {
              "deletedAt": "{{now}}",
              "deletedBy": "{{currentUser}}"
            },
            "interceptors": {
              "afterReturning": [
                {
                  "handler": "invalidateCache",
                  "args": {
                    "cacheNames": ["artists"]
                  },
                  "when": null
                },
                {
                  "handler": "auditLog",
                  "args": {
                    "action": "DELETE",
                    "entity": "Artist"
                  },
                  "when": null
                }
              ]
            },
            "messages": {
              "success": "Artist deleted successfully",
              "error": "Failed to delete artist",
              "notFound": "Artist not found"
            }
          }
        },

        "permissions": {
          "view": ["ADMIN", "SUPERADMIN", "MANAGER"],
