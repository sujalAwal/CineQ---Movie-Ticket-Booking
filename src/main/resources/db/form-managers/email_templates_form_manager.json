      "formSchema": {
        "type": "object",
        "title": "Email Template Form",
        "properties": {
          "name": {
            "type": "STRING",
            "title": "Template Name",
            "placeholder": "e.g., Welcome Email, Password Reset",
            "description": "Unique identifier name for this template",
            "required": true,
            "order": 1
          },
          "slug": {
            "type": "STRING",
            "title": "Template Slug",
            "placeholder": "e.g., welcome-email, password-reset",
            "description": "URL-friendly identifier (lowercase, hyphens allowed)",
            "required": true,
            "order": 2
          },
          "subject": {
            "type": "STRING",
            "title": "Email Subject",
            "placeholder": "e.g., Welcome to CineQ!",
            "description": "Subject line for emails sent to users. Supports placeholders like {{userName}}",
            "required": true,
            "order": 3
          },
          "message": {
            "type": "STRING",
            "title": "Email Message",
            "placeholder": "Enter the email body content...",
            "description": "HTML or text content for user emails. Supports placeholders like {{userName}}, {{bookingId}}",
            "required": true,
            "order": 4,
            "ui": {
              "widget": "rich-text-editor",
              "rows": 10
            }
          },
          "adminSubject": {
            "type": "STRING",
            "title": "Admin Subject",
            "placeholder": "e.g., [Admin] New User Registration",
            "description": "Subject line for admin notification emails (optional)",
            "required": false,
            "order": 5
          },
          "adminMessage": {
            "type": "STRING",
            "title": "Admin Message",
            "placeholder": "Enter the admin notification content...",
            "description": "HTML or text content for admin notification emails (optional). Supports placeholders",
            "required": false,
            "order": 6,
            "ui": {
              "widget": "rich-text-editor",
              "rows": 8
            }
          },
          "isActive": {
            "type": "BOOLEAN",
            "title": "Active",
            "description": "Whether this template is active and can be used",
            "default": true,
            "order": 7
          }
        },
        "required": ["name", "slug", "subject", "message"]
      },

