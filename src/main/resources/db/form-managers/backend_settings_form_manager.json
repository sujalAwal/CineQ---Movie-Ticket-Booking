                "type": "STRING",
                "title": "Setting Title",
                "placeholder": "e.g., Maintenance Mode, Default Page Size, SMTP Host, Rate Limit",
                "description": "Human-readable name for this setting",
                "required": true,
                "order": 1
            },
            "slug": {
                "type": "STRING",
                "title": "Setting Slug",
                "placeholder": "e.g., maintenance-mode, default-page-size, smtp-host",
                "description": "URL-friendly unique identifier (auto-lowercased)",
                "required": true,
                "order": 2
            },
            "type": {
                "type": "STRING",
                "title": "Setting Type",
                "description": "Determines how the value field is rendered and validated",
                "required": true,
                "order": 3,
                "enum": ["text", "textarea", "checkbox", "color", "media", "number", "select", "json", "rich_text", "date", "url", "email"]
            },
            "value": {
                "type": "STRING",
                "title": "Value",
                "description": "The setting value. Interpreted based on the type field.",
                "required": false,
                "order": 4
            },
            "group": {
                "type": "STRING",
                "title": "Group",
                "placeholder": "e.g., system, email, security, performance, features, cache",
                "description": "Reference to a settings group slug (must exist in settings_groups)",
                "required": true,
                "order": 5
            },
            "description": {
                "type": "STRING",
                "title": "Description",
                "placeholder": "What does this setting control?",
                "description": "Help text shown alongside the setting input",
                "required": false,
                "order": 6
            },
            "sortOrder": {
                "type": "INTEGER",
                "title": "Sort Order",
                "description": "Display order within its group (lower = first)",
                "default": 0,
                "required": false,
                "order": 7
            },
            "icon": {
                "type": "STRING",
                "title": "Icon",
                "placeholder": "e.g., server, lock, zap, database",
                "description": "Icon identifier for UI display",
                "required": false,
                "order": 8
            },
            "options": {
                "type": "ARRAY",
                "title": "Options",
                "description": "Available choices for 'select' type settings (JSON array of {label, value})",
                "required": false,
                "order": 9
            },
            "isActive": {
                "type": "BOOLEAN",
                "title": "Active",
                "description": "Whether this setting is currently active",
                "default": true,
                "order": 10
            }
            },
            "required": ["title", "slug", "type", "group"]
