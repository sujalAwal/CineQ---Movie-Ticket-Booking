                  "handler": "logAction",
                  "args": {
                    "message": "Updating movie",
                    "level": "INFO"
                  },
                  "when": null
                }
              ],
              "afterReturning": [
                {
                  "handler": "invalidateCache",
                  "args": {
                    "cacheNames": ["movies"]
                  },
                  "when": null
                },
                {
                  "handler": "auditLog",
                  "args": {
                    "action": "UPDATE",
                    "entity": "Movie",
                    "includeData": true
                  },
                  "when": null
