            "interceptors": {
              "before": [
                {
                  "handler": "logAction",
                  "args": {
                    "message": "Creating new movie",
                    "level": "INFO",
                    "includeFormData": true
                  },
                  "when": null
                }
              ],
              "afterReturning": [
                {
                  "handler": "invalidateCache",
                  "args": {
                    "cacheNames": ["movies"]
                  },
                  "when": null
                },
                {
                  "handler": "auditLog",
                  "args": {
                    "action": "CREATE",
                    "entity": "Movie",
                    "includeData": true
                  },
                  "when": null
                }
              ],
              "afterThrowing": [
                {
                  "handler": "logAction",
                  "args": {
                    "message": "Movie creation failed",
                    "level": "ERROR"
                  },
                  "when": null
                }
              ]
            },
            "messages": {
              "success": "Movie created successfully",
              "error": "Failed to create movie",
              "validation": "Please check the form for errors"
            }
          },

          "update": {
            "enabled": true,
            "autoApprove": true,
            "autoFields": {
              "updatedAt": "{{now}}",
              "updatedBy": "{{currentUser}}"
            },
            "interceptors": {
              "before": [
