{
  "slug": "seat-types",
  "title": "Seat Type Management",
  "description": "Manage seat types with codes and names (Regular, Premium, Recliner, etc.)",
  "modelName": "SeatType",
  "isActive": true,

  "formSteps": [
    {
      "stepSlug": "v1",
      "stepTitle": "Seat Type Configuration",
      "stepOrder": 1,
      "isActive": true,
      "description": "Create, update, or delete seat types",

      "formSchema": {
        "type": "object",
        "title": "Seat Type Form",
        "properties": {
          "code": {
            "type": "STRING",
            "title": "Code",
            "placeholder": "e.g., A, P, R, E, V, M, X, NA",
            "description": "2-4 character unique code for seat type (used in backend logic)",
            "required": true,
            "order": 1
          },
          "name": {
            "type": "STRING",
            "title": "Name",
            "placeholder": "e.g., Regular Seat, Premium, Recliner",
            "description": "Display name for the seat type",
            "required": true,
            "order": 2
          },
          "description": {
            "type": "STRING",
            "title": "Description",
            "placeholder": "Brief description of this seat type...",
            "description": "Details about this seat type",
            "required": false,
            "order": 3
          },
          "isActive": {
            "type": "BOOLEAN",
            "title": "Active",
            "description": "Whether this seat type is available",
            "default": true,
            "order": 4
          }
        },
        "required": ["code", "name"]
      },

      "validationRules": {
        "code": {
          "type": "STRING",
          "collectionField": "code",
          "fieldTransformer": "uppercase",
          "baseValidation": [
            "@NotBlank(message='Code is required')",
            "@Size(min=1, max=4, message='Code must be 1-4 characters')",
            "@Pattern(regexp='^[A-Z0-9]+$', message='Code must contain only uppercase letters and numbers')"
          ],
          "actionRules": {
            "create": [
              "@NotBlank(message='Code is required')",
              "@Size(min=1, max=4)",
              "@Pattern(regexp='^[A-Z0-9]+$')",
              "@Unique(collection='seat_types', field='code', message='Code already exists')"
            ],
            "update": [
              "@Size(min=1, max=4)",
              "@Pattern(regexp='^[A-Z0-9]+$')",
              "@UniqueExcludingSelf(collection='seat_types', field='code', idField='_id', message='Code already exists')"
            ],
            "delete": []
          },
          "serialization": {
            "select": true,
            "outputField": "code"
          }
        },

        "name": {
          "type": "STRING",
          "collectionField": "name",
          "fieldTransformer": "trim",
          "baseValidation": [
            "@NotBlank(message='Name is required')",
            "@Size(min=2, max=50, message='Name must be 2-50 characters')"
          ],
          "actionRules": {
            "create": [
              "@NotBlank(message='Name is required')",
              "@Size(min=2, max=50)",
              "@Unique(collection='seat_types', field='name', message='Name already exists')"
            ],
            "update": [
              "@Size(min=2, max=50)",
              "@UniqueExcludingSelf(collection='seat_types', field='name', idField='_id', message='Name already exists')"
            ],
            "delete": []
          },
          "serialization": {
            "select": true,
            "outputField": "name"
          }
        },

        "description": {
          "type": "STRING",
          "collectionField": "description",
          "fieldTransformer": "trim",
          "baseValidation": [
            "@Size(min=0, max=500, message='Description cannot exceed 500 characters')"
          ],
          "actionRules": {
            "create": [
              "@Size(min=0, max=500)"
            ],
            "update": [
              "@Size(min=0, max=500)"
            ],
            "delete": []
          },
          "serialization": {
            "select": true,
            "outputField": "description"
          }
        },

        "isActive": {
          "type": "BOOLEAN",
          "collectionField": "isActive",
          "fieldTransformer": null,
          "baseValidation": [],
          "actionRules": {
            "create": [],
            "update": [],
            "delete": []
          },
          "serialization": {
            "select": true,
            "outputField": "isActive"
          }
        },

        "id": {
          "type": "STRING",
          "collectionField": "_id",
          "fieldTransformer": null,
          "baseValidation": [],
          "actionRules": {
            "create": [],
            "update": [
              "@NotBlank(message='ID is required for update')",
              "@Exists(collection='seat_types', field='_id', message='Seat type not found')"
            ],
            "delete": [
              "@NotBlank(message='ID is required for delete')",
              "@Exists(collection='seat_types', field='_id', message='Seat type not found')"
            ]
          },
          "serialization": {
            "select": true,
            "outputField": "id"
          }
        }
      },

      "workflowRules": {
        "persistToCollection": true,
        "targetCollection": "seat_types",
        "fieldMapping": {
          "code": "code",
          "name": "name",
          "description": "description",
          "isActive": "isActive"
        },
        "autoFields": {
          "createdAt": "{{now}}",
          "updatedAt": "{{now}}",
          "deletedAt": null,
          "createdBy": "{{currentUser}}",
          "updatedBy": "{{currentUser}}"
        },
        "actions": {
          "create": {
            "enabled": true,
            "autoApprove": true,
            "autoFields": {
              "createdAt": "{{now}}",
              "updatedAt": "{{now}}",
              "deletedAt": null,
              "createdBy": "{{currentUser}}",
              "updatedBy": "{{currentUser}}"
            },
            "interceptors": {
              "before": [
                {
                  "handler": "logAction",
                  "args": {
                    "message": "Creating new seat type",
                    "level": "INFO",
                    "includeFormData": true
                  },
                  "when": null
                }
              ],
              "afterReturning": [
                {
                  "handler": "invalidateCache",
                  "args": {
                    "cacheNames": ["seatTypes"]
                  },
