              "deletedBy": "{{currentUser}}"
            },
            "interceptors": {
              "afterReturning": [
                {
                  "handler": "invalidateCache",
                  "args": {
                    "cacheNames": ["seatTypes"]
                  },
                  "when": null
                }
              ]
            },
            "messages": {
              "success": "Seat type deleted successfully",
              "error": "Failed to delete seat type"
            }
          }
        },

        "permissions": {
          "view": ["ADMIN", "SUPERADMIN"],
          "create": ["ADMIN", "SUPERADMIN"],
          "update": ["ADMIN", "SUPERADMIN"],
          "delete": ["SUPERADMIN"]
        }
      },

      "uiSchema": {
        "layout": "single-column",
        "sections": [
