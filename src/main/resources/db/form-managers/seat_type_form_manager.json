                {
                  "handler": "invalidateCache",
                  "args": {
                    "cacheNames": ["seatTypes"]
                  },
                  "when": null
                },
                {
                  "handler": "auditLog",
                  "args": {
                    "action": "UPDATE",
                    "entity": "SeatType",
                    "includeData": true
                  },
                  "when": null
                }
              ]
            },
            "messages": {
              "success": "Seat type updated successfully",
              "error": "Failed to update seat type"
            }
