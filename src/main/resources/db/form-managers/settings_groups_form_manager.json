      "validationRules": {
        "title": {
          "type": "STRING",
          "collectionField": "title",
          "fieldTransformer": "trim",
          "baseValidation": [
            "@NotBlank(message='Title is required')",
            "@Size(min=2, max=100, message='Title must be 2-100 characters')"
          ],
          "actionRules": {
            "create": [
              "@NotBlank(message='Title is required')",
              "@Size(min=2, max=100)",
              "@Unique(collection='settings_groups', field='title', message='Group title already exists')"
            ],
            "update": [
              "@Size(min=2, max=100)",
              "@UniqueExcludingSelf(collection='settings_groups', field='title', idField='_id', message='Group title already exists')"
            ],
            "delete": []
          },
          "serialization": {
            "select": true,
            "outputField": "title"
          }
        },

        "slug": {
          "type": "STRING",
          "collectionField": "slug",
          "fieldTransformer": "lowercase",
          "baseValidation": [
            "@NotBlank(message='Slug is required')",
            "@Size(min=2, max=100, message='Slug must be 2-100 characters')",
            "@Pattern(regexp='^[a-z0-9_-]+$', message='Only lowercase letters, numbers, hyphens and underscores allowed')"
          ],
          "actionRules": {
            "create": [
              "@NotBlank(message='Slug is required')",
              "@Size(min=2, max=100)",
              "@Pattern(regexp='^[a-z0-9_-]+$')",
              "@Unique(collection='settings_groups', field='slug', message='Slug already exists')"
            ],
            "update": [
              "@Size(min=2, max=100)",
              "@Pattern(regexp='^[a-z0-9_-]+$')",
              "@UniqueExcludingSelf(collection='settings_groups', field='slug', idField='_id', message='Slug already exists')"
            ],
            "delete": []
          },
          "serialization": {
            "select": true,
            "outputField": "slug"
          }
        },

