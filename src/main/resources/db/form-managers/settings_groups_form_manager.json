            "create": [],
            "update": [],
            "delete": []
          },
          "serialization": {
            "select": true,
            "outputField": "isActive"
          }
        },

        "id": {
          "type": "STRING",
          "collectionField": "_id",
          "fieldTransformer": null,
          "baseValidation": [],
          "actionRules": {
            "create": [],
            "update": [
              "@NotBlank(message='ID is required for update')",
              "@Exists(collection='settings_groups', field='_id', message='Settings group not found')"
            ],
            "delete": [
              "@NotBlank(message='ID is required for delete')",
              "@Exists(collection='settings_groups', field='_id', message='Settings group not found')"
            ]
          },
          "serialization": {
            "select": true,
            "outputField": "id"
          }
        }
      },

