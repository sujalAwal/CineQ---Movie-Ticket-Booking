            "description": "URL-friendly unique identifier (auto-lowercased)",
            "required": true,
            "order": 2
          },
          "isActive": {
            "type": "BOOLEAN",
            "title": "Active",
            "description": "Whether this settings group is enabled or disabled",
            "default": true,
            "order": 3
          }
        },
        "required": ["title", "slug"]
